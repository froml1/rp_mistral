# RP_IA — Configuration des modèles par tâche
#
# Chargé automatiquement par llm.py au démarrage.
# Une variable d'environnement explicite prime toujours sur ce fichier.
#   ex : RP_MODEL_TRANSLATE=autre-modele python src/pipeline.py
#
# Modèles à installer avant utilisation :
#   ollama pull qwen2.5:7b      # ~4.7 GB — traduction
#   ollama pull llama3.2:3b     # ~2.0 GB — décisions rapides


# ── Modèle principal ──────────────────────────────────────────────────────────
# Utilisé par défaut pour toute tâche non surchargée ci-dessous.
# Raisonnement narratif, extraction d'entités, synthèse de lore.
RP_MODEL=mistral


# ── Traduction FR→EN (step 2) ─────────────────────────────────────────────────
# qwen2.5:7b : meilleur multilingue ≤7B, nettement supérieur à Mistral 7B
# sur les paires de langues européennes. Respecte mieux les marqueurs *action*.
RP_MODEL_TRANSLATE=qwen2.5:7b


# ── Décisions binaires (steps 3, 4, 5) ───────────────────────────────────────
# Sortie attendue : {"merge": true} / {"is_rp": true} / {"same_scene": false}
# llama3.2:3b : 2 GB, 2-3× plus rapide qu'un 7B, amplement suffisant pour
# un choix oui/non avec peu de contexte.

# clean — fusionner deux scènes adjacentes ?
RP_MODEL_CLEAN=llama3.2:3b

# rp_filter — cette scène est-elle du RP réel ?
RP_MODEL_FILTER=llama3.2:3b

# prefix — le préfixe avant le premier *action* est-il OOC ou in-character ?
RP_MODEL_PREFIX=llama3.2:3b


# ── Découpage de scènes (step 3) ──────────────────────────────────────────────
# Détection des frontières narratives : changement de lieu, de groupe,
# saut temporel. Requiert du raisonnement sur le flux narratif → modèle principal.
RP_MODEL_SPLIT=mistral


# ── Analyse approfondie (step 6) ──────────────────────────────────────────────
# Extraction d'entités (who/where/which), causalité (how), résumé (what).
# Tâche la plus exigeante → modèle principal.
RP_MODEL_ANALYZE=mistral
